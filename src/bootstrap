#!/bin/bash

# Get parameters function
# This function will check all the parameters 
# Return:
#   string: params to run the server
#   int: -1 is something is wrong.

STEAMAPPID=892970
VOLUME_DIR="/opt/valheim"

# box64 settings, exported so box64 actually sees them
export BOX64_LD_LIBRARY_PATH=${VOLUME_DIR}/valheim_server/linux64${BOX64_LD_LIBRARY_PATH:+:$BOX64_LD_LIBRARY_PATH}
export BOX64_LOG=${BOX64_LOG:-1}
export BOX64_TRACE_FILE=${VOLUME_DIR}/valheim_server/output.log
export BOX64_TRACE=${BOX64_TRACE:-0}
# libparty.so (PlayFab Party, used for crossplay) uses libogg without linking
# it, relying on libpulse to have loaded it. box64 runs libpulse natively, so
# preload box64's wrapped libogg to make those symbols available.
export BOX64_LD_PRELOAD=libogg.so.0${BOX64_LD_PRELOAD:+:$BOX64_LD_PRELOAD}

# Accept the env var names used by lloesche/valheim-server as aliases, so
# existing deployments can switch images without renaming everything.
NAME=${NAME:-$SERVER_NAME}
WORLD=${WORLD:-$WORLD_NAME}
PASSWORD=${PASSWORD:-$SERVER_PASS}
PORT=${PORT:-$SERVER_PORT}
PUBLIC=${PUBLIC:-$SERVER_PUBLIC}
SAVEDIR=${SAVEDIR:-$VOLUME_DIR/world}

# Returns success for 1/true/yes, in any case
is_true() {
    case "${1,,}" in
        1|true|yes) return 0 ;;
        *) return 1 ;;
    esac
}

getparams() {
    # Basic + default params values same order that PDF:
    ##  -nographics: basic param for the valheim documentation.
    ##  -batchmode: basic param for the valheim documentation.
    ##  -name: Name of the server
    ##  -port: used the value of the param if defined, if not it will use standard port (2456).
    ##  -world: Name of the world, defaults to default if unset.
    ##  -public: used the value of the param if defined, if not it will be a public server (1).
    ##  -saveinterval: Change how often the world will save in seconds.
    params=(-nographics -batchmode -name "${NAME:-My World}" -port "${PORT:-2456}" -world "${WORLD:-default}")
    if is_true "${PUBLIC:-1}"; then
        params+=(-public 1)
    else
        params+=(-public 0)
    fi
    params+=(-saveinterval "${SAVEINTERVAL:-1800}")

    ## -password: Password for the server.
    if [[ -z "${PASSWORD}" ]]; then
        echo "The variable PASSWORD is not defined! Exiting, as valheim servers require passwords now!"
        exit 1
    fi
    params+=(-password "${PASSWORD}")

    ##  -savedir: Where the data will be saved.
    ##  Overrides the default save path where Worlds and permission-files are stored.
    params+=(-savedir "${SAVEDIR}")

    ##  -logFile: Sets the location to save the log file.
    if [[ -z "${LOGFILE}" ]]; then
        echo "The variable LOGFILE is not defined. Debug messages will be displayed on standard output."
    else
        params+=(-logFile "${LOGFILE}")
    fi

    ##  -backups: Sets how many automatic backups will be kept. 
    ##  The first is the ‘short’ backup length, and the rest are the ‘long’ backup length.
    ##  By default that means one backup that is 2 hours old, and 3 backups that are 12 hours apart.
    ##  BACKUPS=true/false instead toggles our own world backups, see valheim-backup.
    if [[ "${BACKUPS}" =~ ^[0-9]+$ ]]; then
        params+=(-backups "${BACKUPS}")
    else
        params+=(-backups 4)
    fi

    ##  -backupshort: Sets the interval between the first automatic backups.
    ##  Default is 2 hours (7200 seconds).
    params+=(-backupshort "${BACKUPSHORT:-7200}")

    ##  -backuplong: Sets the interval between the subsequent automatic backups.
    ##  Default is 12 hours (43200 seconds).
    params+=(-backuplong "${BACKUPLONG:-43200}")

    ##  -crossplay: Runs the Server on the Crossplay backend (PlayFab), which lets users from any platform join.
    ##  If you do not include this argument (or set to FALSE in the env file), the Steam backend is used, which 
    ##  means only Steam users can see and join the Server.
    if is_true "${CROSSPLAY}"; then
        params+=(-crossplay)
    fi
}

# Write a list of SteamIDs (space or comma separated) to a permission file
# in the save dir. Left untouched when unset, so manual edits are kept.
write_idlist() {
    local file="$1" ids="$2"
    if [[ -n "${ids}" ]]; then
        echo "Writing ${file}..."
        tr -s ' ,' '\n' <<< "${ids}" | sed '/^$/d' > "${SAVEDIR}/${file}"
    fi
}

# Download steam and whatnot
bootstrap() {
    # Use Valve's native ARM64 steamcmd
    if [ ! -x ${VOLUME_DIR}/steamcmd/linuxarm64/steamcmd ]; then
        echo "Installing steamcmd..."
        rm -rf ${VOLUME_DIR}/steamcmd
        mkdir ${VOLUME_DIR}/steamcmd && cd ${VOLUME_DIR}/steamcmd
        curl -sqL "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linuxarm64.tar.gz" | tar zxf -
        cd - > /dev/null
    fi

    # If we exist, make sure we are up to date
    echo "Ensuring valheim is up to date..."
    cd ${VOLUME_DIR}/steamcmd
    # Force the linux platform, as the server is only published for x86_64
    ./steamcmd.sh +@sSteamCmdForcePlatformType linux +force_install_dir ${VOLUME_DIR}/valheim_server +login anonymous +app_update 896660 validate +quit
    cd - > /dev/null

    if [ ! -f ${VOLUME_DIR}/valheim_server/valheim_server.x86_64 ]; then
        echo "Valheim server is not installed, steamcmd failed! Exiting."
        exit 1
    fi

    # Ensure our world dir exists
    if [ ! -d "${SAVEDIR}" ]; then
        mkdir -p "${SAVEDIR}"
    fi

    # Setup server permission lists
    write_idlist adminlist.txt "${ADMINLIST_IDS}"
    write_idlist bannedlist.txt "${BANNEDLIST_IDS}"
    write_idlist permittedlist.txt "${PERMITTEDLIST_IDS}"

    # Setup box64 memory tweaks
    # https://github.com/ptitSeb/box64/issues/1182
    if [ ! -f "~/.box64rc" ]; then
        echo "Adding box64 configuration..."
        cat <<-EOF > ~/.box64rc
[valheim_server.x86_64]
BOX64_DYNAREC_BLEEDING_EDGE=0
BOX64_DYNAREC_BIGBLOCK=0
BOX64_DYNAREC_STRONGMEM=3
EOF
    fi

}

# Main function
main() {
    # set fun env stuff
    export LD_LIBRARY_PATH=${VOLUME_DIR}/valheim_server/linux64:${LD_LIBRARY_PATH}
    export SteamAppId=${STEAMAPPID}

    # Move to the execution folder
    cd ${VOLUME_DIR}/valheim_server

    ## Checking the final parameters to use:
    echo "##############################"
    echo "Final Valheim parameters to run: ${params[*]}"
    echo "##############################"

    # Starting the server:
    # Start periodic world backups, unless disabled with BACKUPS=false.
    # Ran in the background so the server stays PID 1 and gets signals directly.
    if [[ "${BACKUPS}" =~ ^[0-9]+$ ]] || is_true "${BACKUPS:-true}"; then
        echo "Starting world backups every ${BACKUPS_INTERVAL:-3600} seconds..."
        (
            while true; do
                valheim-backup
                sleep "${BACKUPS_INTERVAL:-3600}"
            done
        ) &
    fi

    exec box64 ./valheim_server.x86_64 "${params[@]}"
}

getparams
bootstrap
main
