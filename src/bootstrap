#!/bin/bash

# Get parameters function
# This function will check all the parameters 
# Return:
#   string: params to run the server
#   int: -1 is something is wrong.

# shellcheck source=common
. /usr/local/lib/valheim/common

# box64 settings, exported so box64 actually sees them. Note box64 logs to
# stdout unless BOX64_TRACE_FILE is set. Its log level 1 and up shows the
# server's arguments, including the password, so default to errors only.
export BOX64_LOG=${BOX64_LOG:-0}
export BOX64_TRACE=${BOX64_TRACE:-0}
export BOX64_EMULATED_LIBS=libogg.so.0${BOX64_EMULATED_LIBS:+:$BOX64_EMULATED_LIBS}
export BOX64_LD_PRELOAD=libogg.so.0${BOX64_LD_PRELOAD:+:$BOX64_LD_PRELOAD}

getparams() {
    # Basic + default params values same order that PDF:
    ##  -nographics: basic param for the valheim documentation.
    ##  -batchmode: basic param for the valheim documentation.
    ##  -name: Name of the server
    ##  -port: used the value of the param if defined, if not it will use standard port (2456).
    ##  -world: Name of the world, defaults to default if unset.
    ##  -public: used the value of the param if defined, if not it will be a public server (1).
    ##  -saveinterval: Change how often the world will save in seconds.
    params=(-nographics -batchmode -name "${NAME:-My World}" -port "${PORT}" -world "${WORLD}")
    if is_true "${PUBLIC:-1}"; then
        params+=(-public 1)
    else
        params+=(-public 0)
    fi
    params+=(-saveinterval "${SAVEINTERVAL:-1800}")

    ## -password: Password for the server, optionally read from a file
    ## (e.g. a Docker secret), which takes precedence.
    if [[ -n "${PASSWORD_FILE}" ]]; then
        if [[ ! -r "${PASSWORD_FILE}" ]]; then
            echo "Unable to read PASSWORD_FILE ${PASSWORD_FILE}! Exiting."
            exit 1
        fi
        PASSWORD=$(< "${PASSWORD_FILE}")
    fi
    if [[ -z "${PASSWORD}" ]]; then
        echo "The variable PASSWORD is not defined! Exiting, as valheim servers require passwords now!"
        exit 1
    fi
    params+=(-password "${PASSWORD}")

    ##  -savedir: Where the data will be saved.
    ##  Overrides the default save path where Worlds and permission-files are stored.
    params+=(-savedir "${SAVEDIR}")

    ##  -logFile: Sets the location to save the log file.
    if [[ -z "${LOGFILE}" ]]; then
        echo "The variable LOGFILE is not defined. Debug messages will be displayed on standard output."
    else
        params+=(-logFile "${LOGFILE}")
    fi

    ##  -backups: Sets how many automatic backups will be kept. 
    ##  The first is the ‘short’ backup length, and the rest are the ‘long’ backup length.
    ##  By default that means one backup that is 2 hours old, and 3 backups that are 12 hours apart.
    ##  BACKUPS=true/false instead toggles our own world backups, see valheim-backup.
    # shellcheck disable=SC2153 # BACKUPS is set by the user, not a typo
    if [[ "${BACKUPS}" =~ ^[0-9]+$ ]]; then
        params+=(-backups "${BACKUPS}")
    else
        params+=(-backups 4)
    fi

    ##  -backupshort: Sets the interval between the first automatic backups.
    ##  Default is 2 hours (7200 seconds).
    params+=(-backupshort "${BACKUPSHORT:-7200}")

    ##  -backuplong: Sets the interval between the subsequent automatic backups.
    ##  Default is 12 hours (43200 seconds).
    params+=(-backuplong "${BACKUPLONG:-43200}")

    ##  -crossplay: Runs the Server on the Crossplay backend (PlayFab), which lets users from any platform join.
    ##  If you do not include this argument (or set to FALSE in the env file), the Steam backend is used, which 
    ##  means only Steam users can see and join the Server.
    if is_true "${CROSSPLAY}"; then
        params+=(-crossplay)
    fi

    ## SERVER_ARGS: Additional arguments, e.g. world modifiers like -preset hard
    if [[ -n "${SERVER_ARGS}" ]]; then
        read -r -a extra_args <<< "${SERVER_ARGS}"
        params+=("${extra_args[@]}")
    fi

    # Catch typos in schedules now, rather than tasks silently never running
    local var
    for var in BACKUPS_CRON UPDATE_CRON RESTART_CRON; do
        if [[ -n "${!var}" ]] && ! cron_valid "${!var}"; then
            echo "${var} is not a valid cron schedule: '${!var}'! Exiting."
            exit 1
        fi
    done
}

# When PUID/PGID are set, creates the user, gives it the server files and
# save dir, then re-runs this script as that user
setup_user() {
    if [[ ! "${PUID}" =~ ^[0-9]+$ || ! "${PGID}" =~ ^[0-9]+$ ]]; then
        echo "PUID and PGID must be numeric IDs! Exiting."
        exit 1
    fi
    if [[ "${EUID}" -ne 0 ]] || (( PUID == 0 && PGID == 0 )); then
        return 0
    fi

    getent group "${PGID}" > /dev/null || groupadd -g "${PGID}" valheim
    getent passwd "${PUID}" > /dev/null || useradd -u "${PUID}" -g "${PGID}" -d "${USER_HOME}" -M -s /usr/sbin/nologin valheim

    local dirs=("${USER_HOME}" "${VOLUME_DIR}" "${SAVEDIR}")
    [[ -n "${BACKUPS_DIRECTORY}" ]] && dirs+=("${BACKUPS_DIRECTORY}")
    mkdir -p "${dirs[@]}"
    if [[ -n "${LOGFILE}" ]]; then
        mkdir -p "$(dirname "${LOGFILE}")" && touch "${LOGFILE}" && dirs+=("${LOGFILE}")
    fi
    echo "Running as ${PUID}:${PGID}, updating file ownership..."
    find "${dirs[@]}" \( ! -user "${PUID}" -o ! -group "${PGID}" \) -exec chown -h "${PUID}:${PGID}" {} +

    run_as_user "$@"
}

# Write a list of SteamIDs (space or comma separated) to a permission file
# in the save dir. Left untouched when unset, so manual edits are kept.
write_idlist() {
    local file="$1" ids="$2"
    if [[ -n "${ids}" ]]; then
        echo "Writing ${file}..."
        tr -s ' ,' '\n' <<< "${ids}" | sed '/^$/d' > "${SAVEDIR}/${file}"
    fi
}

# Returns success if directory $1 is on a volume, meaning it or one of its
# parents is a mount point
on_volume() {
    local dir
    dir=$(realpath -e "$1" 2>/dev/null) || return 1
    while [[ "${dir}" != / ]]; do
        mountpoint -q "${dir}" && return 0
        dir=$(dirname "${dir}")
    done
    return 1
}

# Download steam and whatnot
bootstrap() {
    # Ensure our world dir exists
    if [ ! -d "${SAVEDIR}" ]; then
        mkdir -p "${SAVEDIR}"
    fi

    # Refuse to run without a volume for the world, unless allowed
    if ! on_volume "${SAVEDIR}"; then
        if ! is_true "${ALLOW_NO_VOLUME}"; then
            echo "ERROR: ${SAVEDIR} is not a volume mount, your world would be lost when the container is removed! Mount a volume at ${SAVEDIR}, or set ALLOW_NO_VOLUME=true to run anyway. Exiting."
            exit 1
        fi
        echo "WARNING: ${SAVEDIR} is not a volume mount, your world will be lost when the container is removed!"
    fi

    # Use Valve's native ARM64 steamcmd
    if [ ! -x "${STEAMCMD_DIR}/linuxarm64/steamcmd" ]; then
        echo "Installing steamcmd..."
        rm -rf "${STEAMCMD_DIR}"
        mkdir "${STEAMCMD_DIR}" \
            && curl -sqL "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linuxarm64.tar.gz" | tar zxf - -C "${STEAMCMD_DIR}"
    fi

    # If we exist, make sure we are up to date. Retried, as the first run on
    # a fresh steamcmd fails with "Missing configuration".
    echo "Ensuring valheim is up to date..."
    for attempt in 1 2 3; do
        update_server && break
        echo "steamcmd failed (attempt ${attempt}/3)"
    done

    if [ ! -f "${SERVER_DIR}/valheim_server.x86_64" ]; then
        echo "Valheim server is not installed, steamcmd failed! Exiting."
        exit 1
    fi

    # Setup server permission lists
    write_idlist adminlist.txt "${ADMINLIST_IDS}"
    write_idlist bannedlist.txt "${BANNEDLIST_IDS}"
    write_idlist permittedlist.txt "${PERMITTEDLIST_IDS}"

    # box64 detects Mono (BOX64_DYNAREC_BLEEDING_EDGE=1, the default) and
    # applies BIGBLOCK=0 and STRONGMEM=1 for it. The stricter settings once
    # needed (https://github.com/ptitSeb/box64/issues/1182) are much slower,
    # but can still be set via env, e.g. BOX64_DYNAREC_STRONGMEM=3.
    rm -f ~/.box64rc

}

# Starts the server in the background
start_server() {
    # Don't show the password in the log
    local shown=("${params[@]}") i
    for i in "${!shown[@]}"; do
        if [[ "${shown[i]}" = -password ]]; then
            shown[i+1]='********'
        fi
    done
    echo "##############################"
    echo "Final Valheim parameters to run: ${shown[*]}"
    echo "##############################"
    (cd "${SERVER_DIR}" && exec "${server_cmd[@]}" ./valheim_server.x86_64 "${params[@]}") &
    server_pid=$!
}

# Asks the server to shut down, which saves the world. SIGINT is what the
# server handles for a clean shutdown. Killed if it has not exited in time.
stop_server() {
    if [[ -n "${server_pid}" ]] && kill -INT "${server_pid}" 2>/dev/null; then
        echo "Stopping Valheim server..."
        (
            sleep "${SERVER_STOP_TIMEOUT:-120}"
            echo "Valheim server did not stop in time, killing it"
            kill -KILL "${server_pid}" 2>/dev/null
        ) &
        watchdog_pid=$!
    fi
}

# Waits for the server to exit, sets server_rc to its exit code
wait_server() {
    # wait returns early whenever a trapped signal arrives, so keep waiting
    # until the server has actually exited
    while kill -0 "${server_pid}" 2>/dev/null; do
        wait "${server_pid}"
        server_rc=$?
    done
    if [[ -n "${watchdog_pid}" ]]; then
        kill "${watchdog_pid}" 2>/dev/null
        watchdog_pid=
    fi
}

# Signal handlers
on_shutdown() {
    stopping=true
    stop_server
}

# Ignored while the server is not running, e.g. while updating
on_restart() {
    if [[ "${stopping}" != true ]] && kill -0 "${server_pid}" 2>/dev/null; then
        restarting=true
        stop_server
    fi
}

# Main function
main() {
    # set fun env stuff
    export LD_LIBRARY_PATH=${SERVER_DIR}/linux64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export SteamAppId=${STEAMAPPID}

    # Start periodic world backups, unless disabled with BACKUPS=false
    if [[ "${BACKUPS}" =~ ^[0-9]+$ ]] || is_true "${BACKUPS:-true}"; then
        backups=true
        if [[ -n "${BACKUPS_CRON}" ]]; then
            echo "Starting world backups on schedule ${BACKUPS_CRON}..."
        else
            echo "Starting world backups every ${BACKUPS_INTERVAL:-3600} seconds..."
        fi
        (
            valheim-backup
            while wait_next_run "${BACKUPS_CRON}" "${BACKUPS_INTERVAL:-3600}"; do
                valheim-backup
            done
        ) &
    fi

    # Optionally pin the server to specific CPU cores, e.g. the fast cores of
    # a big.LITTLE SoC. Defaults per image, see Dockerfile.
    server_cmd=(box64)
    if [[ -n "${CPU_AFFINITY}" ]]; then
        if taskset -c "${CPU_AFFINITY}" true 2>/dev/null; then
            # box64 reports every core on the host to the server, which sizes
            # its thread pools from that, so only report the pinned cores
            export BOX64_MAXCPU=${BOX64_MAXCPU:-$(taskset -c "${CPU_AFFINITY}" nproc)}
            echo "Pinning Valheim server to CPU cores ${CPU_AFFINITY} (${BOX64_MAXCPU} cores)..."
            server_cmd=(taskset -c "${CPU_AFFINITY}" box64)
        else
            echo "Unable to pin Valheim server to CPU cores ${CPU_AFFINITY}, running unpinned"
        fi
    fi

    # Start periodic update checks and scheduled restarts, the updater
    # signals us with SIGUSR1 when the server should be restarted
    echo $$ > "${SUPERVISOR_PIDFILE}"
    trap on_shutdown TERM INT
    trap on_restart USR1
    valheim-updater &

    # Run the server, restarting (and updating) it when requested by the
    # updater
    while true; do
        start_server
        wait_server

        if [[ "${restarting}" != true || "${stopping}" = true ]]; then
            echo "Valheim server exited with code ${server_rc}"
            exit "${server_rc}"
        fi

        restarting=false
        echo "Valheim server stopped, updating..."
        run_hook "${PRE_RESTART_HOOK}"
        if [[ "${backups}" = true ]]; then
            valheim-backup
        fi
        update_server
        run_hook "${POST_RESTART_HOOK}"
    done
}

setup_user "$@"
getparams
bootstrap
main
